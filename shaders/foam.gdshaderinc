float foam_disc(vec2 pos, vec2 c, float r, float edge) {
    c = abs(pos - c);
    c = min(c, 1.0 - c);
    return smoothstep(0.0, edge, r - sqrt(dot(c, c))) * -1.0;
}

float foam_layer(vec2 uv, float radius_scale, float edge) {
    uv = mod(uv, 1.0);
    float ret = 1.0;
    for (int i = 0; i < 75; i++) {
        ret += foam_disc(uv, FOAM_DISCS[i].xy, sqrt(FOAM_DISCS[i].z) * radius_scale, edge);
    }
    return max(ret, 0.0);
}

vec2 foam_swirl(vec2 uv, float t) {
    float d1 = t * 0.07 + mod(uv.x + uv.y, TAU);
    float d2 = t * 0.5 + mod((uv.x + uv.y + 0.25) * 1.3, 3.0 * TAU);
    return vec2(sin(d1) * 0.15 + sin(d2) * 0.05,
                cos(d1) * 0.15 + cos(d2) * 0.05);
}
